{
  "name": "ax-lint",
  "version": "0.0.1",
  "description": "Catch broken and unsafe Google AX manifests before they reach your cluster.",
  "license": "MIT",
  "author": "Royal Pinto <royalpinto007@gmail.com>",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "ax-lint": "dist/cli.js"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "keywords": [
    "google-ax",
    "ax",
    "manifest",
    "yaml",
    "linter",
    "validation",
    "cli",
    "security",
    "devops",
    "ci",
    "kubernetes",
    "agent"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/royalpinto007/ax-lint.git"
  },
  "homepage": "https://github.com/royalpinto007/ax-lint#readme",
  "bugs": {
    "url": "https://github.com/royalpinto007/ax-lint/issues"
  },
  "scripts": {
    "build": "tsup",
    "clean": "node scripts/clean.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "check:contract": "node scripts/check-upstream-contract.mjs",
    "check:package": "npm run build && publint && attw --pack . --ignore-rules cjs-resolves-to-esm",
    "prepack": "npm run build"
  },
  "dependencies": {
    "tinyglobby": "0.2.17",
    "yaml": "2.9.1"
  },
  "overrides": {
    "esbuild": "0.28.2"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.2",
    "@vitest/coverage-v8": "5.0.1",
    "eslint": "10.11.0",
    "prettier": "3.9.8",
    "publint": "0.3.24",
    "tsup": "8.5.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1",
    "vitest": "5.0.1"
  }
}
